---
import '../styles/footer.css';
interface Props {
  instagramUrl?: string;
  youtubeUrl?: string;
  spotifyUrl?: string;
}
const { instagramUrl, youtubeUrl, spotifyUrl } = Astro.props;
const navigation = [
  { label: 'Concepto', href: '#saque' },
  { label: 'Entrenamiento', href: '#respuesta' },
  { label: 'Experiencia', href: '#intercambio' },
];
// Contenido SVG estático; las URLs se pasan como propiedades del componente.
const socials = [
  {
    name: 'Instagram', href: instagramUrl,
    paths: '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".9" fill="currentColor" stroke="none"/>',
  },
  {
    name: 'YouTube', href: youtubeUrl,
    paths: '<rect x="2" y="5" width="20" height="14" rx="4"/><path d="m10 9 6 3-6 3Z" fill="currentColor" stroke="none"/>',
  },
  {
    name: 'Spotify', href: spotifyUrl,
    paths: '<circle cx="12" cy="12" r="9"/><path d="M6.7 9.3c3.7-1.2 7.4-.9 10.6.8M7.4 12.4c3-1 6.2-.7 8.8.6M8.2 15.3c2.4-.7 4.7-.5 6.9.5"/>',
  },
];
---
<footer class="site-footer" aria-label="Pie de página de Tennis School">
  <div class="site-footer__inner">
    <a class="site-footer__brand" href="#saque" aria-label="Tennis School, volver al inicio">
      TENNIS <span aria-hidden="true">/</span> <em>SCHOOL</em>
    </a>
    <nav class="site-footer__nav" aria-label="Navegación del pie de página">
      <ul>
        {navigation.map(({label, href}) => <li><a href={href}>{label}</a></li>)}
      </ul>
    </nav>
    <div class="site-footer__end">
      <ul class="site-footer__socials" aria-label="Redes sociales">
        {socials.map(({name,href,paths}) => (
          <li>
            {href ? (
              <a class="site-footer__social" href={href} target="_blank" rel="noopener noreferrer" aria-label={`${name} de Tennis School (se abre en otra pestaña)`}>
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths} />
              </a>
            ) : (
              <span class="site-footer__social site-footer__social--inactive" role="img" aria-label={`${name}, enlace no disponible`}>
                <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths} />
              </span>
            )}
          </li>
        ))}
      </ul>
      <p class="site-footer__motto">Juego.<br />Personas.<br />Progreso.</p>
    </div>
  </div>
</footer>
