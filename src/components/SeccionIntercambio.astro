---
import '../styles/seccion-intercambio.css';
interface Props { impactFrame?: number; }
const { impactFrame = 55 } = Astro.props;
// 55 es provisional: ajusta el impacto con /?debug=1 y guarda el número.
const config = {
  frameCount: 94,
  impactFrame,
  revealFrames: 7,
  frameDirectory: `${import.meta.env.BASE_URL}ESCENA-3-WebP/`,
};
---
<tennis-rally class="rally-scene" id="intercambio" data-config={JSON.stringify(config)}>
  <section class="rally-scene__stage" aria-labelledby="intercambio-title">
    <div class="rally-scene__visual">
      <img class="rally-scene__poster" src={`${config.frameDirectory}ezgif-frame-001.jpg`} alt="Tenista preparado para responder con un golpe de derecha en una pista oscura." width="1920" height="1080" loading="lazy" decoding="async" />
      <canvas class="rally-scene__canvas" aria-hidden="true"></canvas>
    </div>
    <div class="rally-scene__shade" aria-hidden="true"></div>
    <div class="rally-scene__copy">
      <p class="rally-scene__chapter"><span aria-hidden="true"></span><b>03</b> / EL INTERCAMBIO</p>
      <h2 id="intercambio-title">Cada golpe<br />te hace mejor.</h2>
      <p class="rally-scene__description">Más que tenis, un proceso de superación.<br />Mejora, punto a punto.</p>
      <dl class="rally-scene__benefits" aria-label="Nuestra propuesta">
        <div><dt>01</dt><dd>Entrenamiento<br />a tu medida</dd></div>
        <div><dt>02</dt><dd>Evolución<br />en cada sesión</dd></div>
      </dl>
    </div>
    <footer class="rally-scene__footer">
      <span>03 / EL INTERCAMBIO</span>
      <p>Desliza para avanzar o retroceder <span aria-hidden="true">↕</span></p>
      <div class="rally-scene__track" aria-hidden="true"><span></span></div>
    </footer>
    <p class="rally-scene__status" role="status" aria-live="polite"></p>
    <aside class="rally-scene__debug" hidden aria-label="Ajuste de la tercera escena">
      <strong>ESCENA 03 · AJUSTE DEL IMPACTO</strong>
      <label>Fotograma <output class="rally-frame">1 / 94</output>
        <input class="rally-scrub" type="range" min="1" max="94" value="1" />
      </label>
      <label>Impacto <input class="rally-impact" type="number" min="1" max="94" value={impactFrame} /></label>
      <small>El 55 es provisional. Localiza el contacto y guarda el número en impactFrame.</small>
    </aside>
    <noscript><style>.rally-scene{height:auto;min-height:100svh}.rally-scene__copy{opacity:1!important;visibility:visible!important;transform:none!important}.rally-scene__footer{display:none}</style></noscript>
  </section>
</tennis-rally>
<script src="../scripts/seccion-intercambio.js"></script>
