---
import HeroSaque from '../components/HeroSaque.astro';
import SeccionRespuesta from '../components/SeccionRespuesta.astro';
import SeccionIntercambio from '../components/SeccionIntercambio.astro';
import SeccionCierre from '../components/SeccionCierre.astro';
import Footer from '../components/Footer.astro';
import '../styles/hero-saque.css';
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#080e0f" />
    <meta name="description" content="Tennis School. Técnica, energía y pasión en cada punto." />
    <title>Tennis School · Todo empieza con un saque</title>
  </head>
  <body>
    <main>
      <HeroSaque />
      <SeccionRespuesta />
      <SeccionIntercambio />
      <SeccionCierre />
    </main>
    <Footer />
  </body>
</html>
